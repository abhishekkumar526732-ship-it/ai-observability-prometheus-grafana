# ==============================================================================
# Git Ignore - Observability & AI Service Workspace
# ==============================================================================

# Python Byte-compiled & cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Code Quality Caches
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Environments & Secret Credentials
.env
.env.local
.env.*.local
venv/
.venv/
env/
ENV/

# Whitelist safe configuration templates
!.env.example
!**/env.example
!**/terraform.tfvars.example

# Terraform State & Cache Files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Operating System & Editor Files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Container & Service Logs
*.log
docker-compose.override.yml
