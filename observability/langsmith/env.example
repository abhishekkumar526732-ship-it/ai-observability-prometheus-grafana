# ==============================================================================
# LangSmith Observability & Tracing Configuration (Phase 2 Extension)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real API keys to version control.
# - NEVER inject these variables into frontend Docker images or static assets.
# - In production Kubernetes, mount these variables securely via Kubernetes Secrets
#   or AWS Secrets Manager (via External Secrets Operator / CSI Secrets Driver).
# ==============================================================================

# Enable LangChain / LangSmith Tracing (true / false)
LANGSMITH_TRACING=true

# LangSmith API Key (obtain from https://smith.langchain.com/settings)
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here

# LangSmith Project Name (logical grouping for sessions and trace datasets)
LANGSMITH_PROJECT=qa-chatbot-prod

# LangSmith API Endpoint (default: hosted cloud SaaS)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# Preserved AI Provider Configuration (Existing Q&A Chatbot Core)
# DO NOT RENAME OR REMOVE THESE EXISTING APPLICATION VARIABLES
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
REASONING_EFFORT=medium
