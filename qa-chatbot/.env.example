# ==============================================================================
# Q&A Chatbot Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Fill in your valid Groq API key from https://console.groq.com/keys
# 3. Adjust parameters as appropriate for your deployment environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq AI Provider Settings
# ------------------------------------------------------------------------------
# Required: Your Groq API authentication key. Do not commit your real key!
GROQ_API_KEY=gsk_your_groq_api_key_here

# Model identifier supported by Groq
# OpenAI's Flagship 120B MoE Reasoning Model on Groq LPUs: openai/gpt-oss-120b
# Other popular models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# Optional reasoning effort for OpenAI GPT-OSS reasoning models: none, low, medium, high
REASONING_EFFORT=medium

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
# Environment mode: development, staging, production, test
APP_ENV=development

# Host interface and port for the FastAPI backend service
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# LLM Generation Parameters
# ------------------------------------------------------------------------------
# Sampling temperature (0.0 to 2.0). Lower is more deterministic.
LLM_TEMPERATURE=0.2

# Maximum output tokens to generate per completion
LLM_MAX_TOKENS=1024

# Timeout in seconds for LLM provider API requests
LLM_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Conversation & Guardrail Limits
# ------------------------------------------------------------------------------
# Maximum permitted character length for a single user query
MAX_MESSAGE_LENGTH=4000

# Maximum number of conversation turns (user + assistant pairs) retained in memory
MAX_HISTORY_TURNS=10

# ------------------------------------------------------------------------------
# LangSmith Observability & Tracing Configuration
# ------------------------------------------------------------------------------
# Set to true to enable LangSmith tracing for local testing and monitoring
LANGSMITH_TRACING=false

# LangSmith API key from https://smith.langchain.com/settings
# Required when LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here

# Project name for grouping traces in LangSmith (e.g. qa-chatbot-local)
LANGSMITH_PROJECT=qa-chatbot-local

# LangSmith API Endpoint (default: hosted cloud SaaS)
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
